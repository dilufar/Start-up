generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  products  Product[]
  employees Employee[]
  sales     Sale[]
  expenses  Expense[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OWNER")
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Product {
  id        String     @id @default(cuid())
  name      String
  category  String     @default("Boshqa")
  sku       String?
  unit      String     @default("dona")
  price     Decimal    @db.Decimal(14, 2)
  cost      Decimal    @default(0) @db.Decimal(14, 2)
  stock     Decimal    @default(0) @db.Decimal(14, 3)
  minStock  Decimal    @default(0) @db.Decimal(14, 3)
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  position  String   @default("Sotuvchi")
  salary    Decimal? @db.Decimal(14, 2)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Sale {
  id          String     @id @default(cuid())
  total       Decimal    @db.Decimal(14, 2)
  paymentType String     @default("CASH")
  note        String?
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items       SaleItem[]
  createdAt   DateTime   @default(now())

  @@index([storeId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("Boshqa")
  amount    Decimal  @db.Decimal(14, 2)
  note      String?
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}
